{{define "user_edit.tmpl"}}
<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <title>Edit User</title>
  <style>
    body { font-family: Arial, sans-serif; margin: 2rem; }
    header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem; }
    nav a { margin-right: 1rem; }
    label { display: block; margin-top: 0.75rem; }
    input { width: 100%; padding: 0.35rem; box-sizing: border-box; }
  </style>
</head>
<body>
  <header>
    <div>
      <strong>PNS Admin</strong>
      <nav>
        <a href="/admin/promotions">Promotions</a>
        <a href="/admin/users">Users</a>
      </nav>
    </div>
    <form action="/logout" method="post"><button type="submit">Logout</button></form>
  </header>
  <h2>Edit User</h2>
  <form method="post" action="/admin/users/{{.user.ID}}/update">
    <label>Email<input type="email" name="email" value="{{.user.Email}}" required></label>
    <label>New Password (leave blank to keep)<input type="password" name="password"></label>
    <button type="submit" style="margin-top:1rem;">Save</button>
  </form>
</body>
</html>
{{end}}

